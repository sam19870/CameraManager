<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ========= TP-Link Tapo 风格 浅色主题（默认） ========= -->
    <style name="Theme.CameraManager" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="materialAlertDialogTheme">@style/AlertDialogLight</item>
    </style>

    <!-- 视频预览页专用（深色沉浸） -->
    <style name="Theme.CameraManager.Preview" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/bg_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@android:color/black</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="materialAlertDialogTheme">@style/AlertDialogLight</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="AlertDialogLight" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/bg_card</item>
    </style>

    <!-- 兼容旧引用（现在用的Light版本） -->
    <style name="AlertDialogDark" parent="AlertDialogLight"/>

    <!-- 分组标题 -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- 卡片内分隔线 -->
    <style name="DividerLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/divider</item>
        <item name="android:layout_marginStart">54dp</item>
    </style>

    <!-- PTZ 方向按钮（单独使用时） -->
    <style name="PtzButton">
        <item name="android:background">@drawable/bg_ptz_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Tapo 风格底部工具栏按钮（5个均匀分布，图标+文字纵向） -->
    <style name="ToolBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 旧版兼容别名 -->
    <style name="IconActionBtn" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/white</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:layout_marginHorizontal">2dp</item>
    </style>

    <!-- 通用操作按钮（扁平胶囊型） -->
    <style name="ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- TP-Link 官方设置页：分组灰条标题 -->
    <style name="SettingSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/section_bg</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <!-- TP-Link 官方设置页：行分割线 -->
    <style name="SettingDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- 官方风格加粗居中标题 -->
    <style name="TextAppearance.CameraManager.ToolbarBold" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- 分屏切换 Chip 按钮 -->
    <style name="ChipButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/bg_card</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingHorizontal">4dp</item>
    </style>
</resources>
