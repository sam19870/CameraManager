<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============== TP-Link Tapo 风格配色（浅色主题） ============== -->

    <!-- ========== TP-LINK 物联 2025 & 乐橙 Imou 官方配色 ========== -->

    <!-- 品牌主色：乐橙 Imou 蓝（更现代，不刺眼），与 TP-LINK 青绿双辅色系 -->
    <color name="brand_primary">#2B7CFF</color>
    <color name="brand_primary_dark">#1E64D6</color>
    <color name="brand_primary_soft">#EAF1FF</color>

    <!-- 品牌辅色：乐橙 Imou 青绿（在线/成功高亮） -->
    <color name="brand_accent">#12C2A0</color>
    <color name="brand_accent_soft">#E3F8F2</color>

    <!-- 警示色 -->
    <color name="online_green">#12C2A0</color>
    <color name="offline_gray">#9AA3B2</color>
    <color name="warning_orange">#FF8A3D</color>
    <color name="error_red">#F5555B</color>

    <!-- 背景：极简浅灰白 + 卡片纯白，大圆角扁平化 -->
    <color name="bg_page">#F4F6FB</color>
    <color name="bg_card">#FFFFFF</color>
    <color name="bg_card_2">#EEF2F8</color>
    <color name="bg_dark">#1A1E28</color>

    <!-- 分割线 -->
    <color name="divider">#EEF0F5</color>

    <!-- 文字颜色：字重分明，标题-正文-辅助-占位4级区分 -->
    <color name="text_primary">#131A2A</color>
    <color name="text_secondary">#55607A</color>
    <color name="text_tertiary">#98A1B8</color>
    <color name="text_hint">#B8C0D4</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#131A2A</color>

    <!-- 输入框 -->
    <color name="input_bg">#F4F6FB</color>

    <!-- 按钮禁用 -->
    <color name="btn_disabled">#C3CADB</color>

    <!-- ============ 设置页图标圆形底色（乐橙/TP-LINK 风格：饱和度适中） ============ -->
    <color name="icon_orange">#FF9548</color>
    <color name="icon_teal">#12C2A0</color>
    <color name="icon_gray">#98A1B8</color>
    <color name="icon_blue">#2B7CFF</color>
    <color name="icon_purple">#7A70FF</color>
    <color name="section_bg">#F1F3F8</color>

    <!-- ============ 旧命名别名（兼容现有引用） ============ -->
    <color name="alarm_red">@color/error_red</color>
    <color name="surface">@color/bg_card</color>
    <color name="ptz_btn">#2C3140</color>
    <color name="ptz_btn_pressed">@color/brand_primary</color>
    <color name="ptz_center">@color/brand_primary</color>
</resources>
