<?xml version="1.0" encoding="utf-8"?>
<!-- 手机端标准尺寸（参考乐橙/TP-LINK App）：间距12/16体系，字号11/12/14三级，圆角10/12/14 -->
<resources>
    <!-- 全局间距 -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">12dp</dimen>
    <dimen name="spacing_lg">16dp</dimen>
    <dimen name="spacing_xl">20dp</dimen>
    <dimen name="spacing_xxl">28dp</dimen>

    <!-- 卡片圆角 -->
    <dimen name="card_radius_sm">8dp</dimen>
    <dimen name="card_radius_md">12dp</dimen>
    <dimen name="card_radius_lg">16dp</dimen>
    <dimen name="corner_tag">6dp</dimen>

    <!-- 字号：正文/辅助/占位4级分明 -->
    <dimen name="text_xxs">10sp</dimen>
    <dimen name="text_xs">11sp</dimen>
    <dimen name="text_sm">12sp</dimen>
    <dimen name="text_md">14sp</dimen>
    <dimen name="text_lg">16sp</dimen>
    <dimen name="text_xl">18sp</dimen>
    <dimen name="text_title">20sp</dimen>

    <!-- 图标 -->
    <dimen name="icon_sm">16dp</dimen>
    <dimen name="icon_md">20dp</dimen>
    <dimen name="icon_lg">24dp</dimen>
    <dimen name="icon_card">36dp</dimen>
    <dimen name="icon_circle_bg">40dp</dimen>

    <!-- 组件高度 -->
    <dimen name="row_height">56dp</dimen>
    <dimen name="row_height_lg">72dp</dimen>
    <dimen name="input_height">48dp</dimen>
    <dimen name="btn_height">48dp</dimen>

    <!-- 设备卡片封面高度 -->
    <dimen name="device_cover_height">104dp</dimen>

    <!-- 工具栏 -->
    <dimen name="toolbar_elevation">0dp</dimen>
</resources>
