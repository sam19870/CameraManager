<?xml version="1.0" encoding="utf-8"?>
<!-- 云台控制面板底部「转盘」背景 —— 乐橙 App 风格：深色渐变圆盘 + 中心圆 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#2AFFFFFF"/>
        </shape>
    </item>
    <item android:inset="2dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#33FFFFFF"/>
            <solid android:color="#15FFFFFF"/>
        </shape>
    </item>
    <item android:inset="80dp">
        <shape android:shape="oval">
            <solid android:color="#3D2B7CFF"/>
            <stroke android:width="0.6dp" android:color="#80FFFFFF"/>
        </shape>
    </item>
</layer-list>
