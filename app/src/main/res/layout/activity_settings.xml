<?xml version="1.0" encoding="utf-8"?>
<!-- 摄像头设置页：参考 TP-LINK 物联 App 官方布局（分组灰条 + 白色行 + 智能侦测彩色圆标宫格） -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_page">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            app:title="摄像机设置"
            app:titleTextColor="@color/text_primary"
            app:titleTextAppearance="@style/TextAppearance.CameraManager.ToolbarBold"
            app:navigationIcon="@drawable/ic_back_dark"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="32dp">

            <!-- ========== 设备头部 ========== -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@color/white" android:padding="14dp">
                <ImageView android:id="@+id/ivThumb"
                    android:layout_width="96dp" android:layout_height="62dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_camera_cover"
                    android:contentDescription="thumb"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView android:id="@+id/tvDeviceName"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView android:id="@+id/tvDeviceAddr"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_tertiary" android:contentDescription="arrow"/>
            </LinearLayout>

            <!-- ========== 消息与报警 ========== -->
            <TextView style="@style/SettingSectionHeader" android:text="消息与报警"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardElevation="0dp" app:cardCornerRadius="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/white">
                    <include android:id="@+id/rowNotify" layout="@layout/item_setting_row"/>
                    <View style="@style/SettingDivider" android:layout_marginStart="16dp"/>
                    <include android:id="@+id/rowAlarm" layout="@layout/item_setting_row"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 智能侦测（官方彩色圆标宫格） ========== -->
            <TextView style="@style/SettingSectionHeader" android:text="智能侦测"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardElevation="0dp" app:cardCornerRadius="0dp">
                <GridLayout android:id="@+id/gridDetect"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:columnCount="4" android:background="@color/white"
                    android:paddingBottom="6dp"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 设备控制 ========== -->
            <TextView style="@style/SettingSectionHeader" android:text="设备控制"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardElevation="0dp" app:cardCornerRadius="0dp">
                <include android:id="@+id/rowDeviceControl" layout="@layout/item_setting_row"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 存储 ========== -->
            <TextView style="@style/SettingSectionHeader" android:text="存储"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardElevation="0dp" app:cardCornerRadius="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/white">
                    <include android:id="@+id/rowCloud" layout="@layout/item_setting_row"/>
                    <View style="@style/SettingDivider" android:layout_marginStart="16dp"/>
                    <include android:id="@+id/rowSd" layout="@layout/item_setting_row"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 智能工具 ========== -->
            <TextView style="@style/SettingSectionHeader" android:text="智能工具"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardElevation="0dp" app:cardCornerRadius="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/white">
                    <include android:id="@+id/rowTrack" layout="@layout/item_setting_row"/>
                    <View style="@style/SettingDivider" android:layout_marginStart="16dp"/>
                    <include android:id="@+id/rowVoiceTip" layout="@layout/item_setting_row"/>
                    <View style="@style/SettingDivider" android:layout_marginStart="16dp"/>
                    <include android:id="@+id/rowOffline" layout="@layout/item_setting_row"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 侦测与网络 ========== -->
            <TextView style="@style/SettingSectionHeader" android:text="侦测与网络"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardElevation="0dp" app:cardCornerRadius="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/white">
                    <include android:id="@+id/rowRules" layout="@layout/item_setting_row"/>
                    <View style="@style/SettingDivider" android:layout_marginStart="16dp"/>
                    <include android:id="@+id/rowRegion" layout="@layout/item_setting_row"/>
                    <View style="@style/SettingDivider" android:layout_marginStart="16dp"/>
                    <include android:id="@+id/rowAlarmLog" layout="@layout/item_setting_row"/>
                    <View style="@style/SettingDivider" android:layout_marginStart="16dp"/>
                    <include android:id="@+id/rowRoute" layout="@layout/item_setting_row"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 设备管理 ========== -->
            <TextView style="@style/SettingSectionHeader" android:text="设备管理"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardElevation="0dp" app:cardCornerRadius="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/white">
                    <include android:id="@+id/rowFirmware" layout="@layout/item_setting_row"/>
                    <View style="@style/SettingDivider" android:layout_marginStart="16dp"/>
                    <include android:id="@+id/rowReboot" layout="@layout/item_setting_row"/>
                    <View style="@style/SettingDivider" android:layout_marginStart="16dp"/>
                    <include android:id="@+id/rowSelfCheck" layout="@layout/item_setting_row"/>
                    <View style="@style/SettingDivider" android:layout_marginStart="16dp"/>
                    <include android:id="@+id/rowDeviceInfo" layout="@layout/item_setting_row"/>
                    <View style="@style/SettingDivider" android:layout_marginStart="16dp"/>
                    <include android:id="@+id/rowDelete" layout="@layout/item_setting_row"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/tvCapStatus"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_tertiary" android:textSize="11sp"/>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
