<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="12dp"
    android:background="@drawable/bg_card_rounded" android:layout_margin="6dp"
    android:gravity="center_vertical">

    <View android:layout_width="36dp" android:layout_height="36dp"
        android:background="@drawable/ic_camera"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/scanName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"
            android:text="ONVIF 摄像头"/>
        <TextView android:id="@+id/scanHost"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:text="192.168.1.10:554"/>
        <TextView android:id="@+id/scanMfr"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/text_secondary"
            android:textSize="12sp" android:text="Unknown · Unknown"/>
    </LinearLayout>

    <TextView android:id="@+id/scanBadge"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@color/brand_primary" android:padding="6dp"
        android:textColor="@color/white" android:textSize="12sp" android:text="云台/ONVIF"/>
</LinearLayout>
