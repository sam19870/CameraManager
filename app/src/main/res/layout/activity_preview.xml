<?xml version="1.0" encoding="utf-8"?>
<!-- 对标 TP-Link Tapo App 官方预览页布局 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 全屏视频容器 -->
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@android:color/black"/>

    <!-- 整体竖向布局：视频透明 + 底部控件 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部状态栏：Tapo风格，半透明黑底 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="#99000000"
            android:paddingHorizontal="6dp" android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <ImageView android:id="@+id/btnBack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back_white"
                app:tint="@color/white"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:paddingStart="2dp"
                android:orientation="vertical">
                <TextView android:id="@+id/deviceName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/white" android:textStyle="bold"
                    android:textSize="15sp"/>
                <TextView android:id="@+id/routeText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF" android:textSize="10sp"
                    android:visibility="gone"/>
            </LinearLayout>

            <TextView android:id="@+id/statusText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#80FFFFFF" android:textSize="10sp"
                android:layout_marginEnd="4dp"/>

            <!-- 设置齿轮图标（Tapo风格：右上角） -->
            <ImageView android:id="@+id/btnMore"
                android:layout_width="40dp" android:layout_height="40dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_gear"
                app:tint="@color/white"/>
        </LinearLayout>

        <!-- 中间填充 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/recordIndicator"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_red_pill"
                android:paddingHorizontal="8dp" android:paddingVertical="2dp"
                android:textColor="@color/white" android:textSize="10sp"
                android:text="● REC"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- 重连蒙层 -->
        <LinearLayout android:id="@+id/reconnectOverlay"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="#CC000000"
            android:paddingHorizontal="12dp" android:paddingVertical="8dp"
            android:visibility="gone">
            <ProgressBar android:id="@+id/reconnectProgress"
                android:layout_width="20dp" android:layout_height="20dp"
                android:indeterminateTint="@color/white"
                android:visibility="gone"/>
            <TextView android:id="@+id/reconnectHint"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="#FFCDD2" android:textSize="12sp"/>
            <Button android:id="@+id/btnReconnect"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginStart="8dp"
                style="?attr/materialButtonOutlinedStyle"
                android:textColor="@color/white"
                app:strokeColor="@color/white"
                android:textSize="12sp" android:text="重连"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ====== Tapo 风格底部工具栏 ====== -->
        <!-- 第一行：5个核心功能按钮（截图/录像/音量/对讲/云台），均匀分布 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp" android:paddingBottom="2dp">

            <LinearLayout android:id="@+id/btnSnapshot"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                    android:src="@drawable/ic_snapshot" app:tint="@color/white"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="截图" android:textColor="@color/white"
                    android:textSize="11sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnRecord"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:id="@+id/recordIcon" android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_record" app:tint="@color/alarm_red"/>
                <TextView android:id="@+id/recordLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="录像" android:textColor="@color/white"
                    android:textSize="11sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnMute"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:id="@+id/muteIcon" android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_volume" app:tint="@color/white"/>
                <TextView android:id="@+id/muteLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="有声" android:textColor="@color/white"
                    android:textSize="11sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnAudio"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                    android:src="@drawable/ic_mic" app:tint="@color/white"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="对讲" android:textColor="@color/white"
                    android:textSize="11sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnPtz"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                    android:src="@drawable/ic_ptz_control" app:tint="@color/white"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="云台" android:textColor="@color/white"
                    android:textSize="11sp" android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 第二行：回放按钮（Tapo风格：Playback & Download） -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#CC000000"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp" android:paddingBottom="10dp">

            <LinearLayout android:id="@+id/btnPlayback"
                style="@style/ToolBtn" android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_tool_rounded"
                android:paddingHorizontal="24dp" android:paddingVertical="8dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_playback"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  回放和下载" android:textColor="@color/white"
                    android:textSize="13sp" android:layout_marginStart="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnMoreTools"
                style="@style/ToolBtn" android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_tool_rounded"
                android:paddingHorizontal="20dp" android:paddingVertical="8dp"
                android:layout_marginStart="12dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_toolbox"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  更多" android:textColor="@color/white"
                    android:textSize="13sp" android:layout_marginStart="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ====== 云台控制盘（Tapo风格：方向键圆盘） ====== -->
        <LinearLayout android:id="@+id/ptzPanel"
            android:layout_width="match_parent" android:layout_height="240dp"
            android:gravity="center"
            android:background="#DD000000"
            android:visibility="gone"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="220dp" android:layout_height="220dp">

                <!-- 圆形底盘 -->
                <View android:layout_width="200dp" android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ptz_disc"/>

                <!-- 上方向键 -->
                <ImageView android:id="@+id/ptzUp"
                    android:layout_width="56dp" android:layout_height="56dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="14dp" android:src="@drawable/ic_ptz_up"
                    android:contentDescription="上"
                    app:tint="@color/white"/>

                <!-- 下方向键 -->
                <ImageView android:id="@+id/ptzDown"
                    android:layout_width="56dp" android:layout_height="56dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="14dp" android:src="@drawable/ic_ptz_down"
                    android:contentDescription="下"
                    app:tint="@color/white"/>

                <!-- 左方向键 -->
                <ImageView android:id="@+id/ptzLeft"
                    android:layout_width="56dp" android:layout_height="56dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="14dp" android:src="@drawable/ic_ptz_left"
                    android:contentDescription="左"
                    app:tint="@color/white"/>

                <!-- 右方向键 -->
                <ImageView android:id="@+id/ptzRight"
                    android:layout_width="56dp" android:layout_height="56dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="14dp" android:src="@drawable/ic_ptz_right"
                    android:contentDescription="右"
                    app:tint="@color/white"/>

                <!-- 中心缩放按钮组 -->
                <LinearLayout
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:orientation="horizontal"
                    android:gravity="center">
                    <ImageView android:id="@+id/ptzZoomOut"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp" android:src="@drawable/ic_zoom_out"
                        android:contentDescription="缩小"
                        app:tint="@color/white"/>
                    <View android:layout_width="12dp" android:layout_height="1dp"/>
                    <ImageView android:id="@+id/ptzZoomIn"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp" android:src="@drawable/ic_zoom_in"
                        android:contentDescription="放大"
                        app:tint="@color/white"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ====== 内联对讲面板 ====== -->
        <LinearLayout android:id="@+id/audioPanel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#DD000000"
            android:paddingHorizontal="12dp" android:paddingVertical="8dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#80FFFFFF" android:textSize="11sp"
                    android:text="按住说话模式"/>
                <ImageView android:id="@+id/audioClose"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="@color/white"/>
            </LinearLayout>

            <RadioGroup android:id="@+id/audioModeGroup"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">
                <RadioButton android:id="@+id/radioHoldTalk"
                    android:layout_width="0dp" android:layout_height="36dp"
                    android:layout_weight="1" android:textSize="12sp"
                    android:textColor="@color/white" android:text="按住说话"
                    android:buttonTint="@color/brand_primary"/>
                <RadioButton android:id="@+id/radioFullDuplex"
                    android:layout_width="0dp" android:layout_height="36dp"
                    android:layout_weight="1" android:textSize="12sp"
                    android:textColor="@color/white" android:text="电话对讲"
                    android:buttonTint="@color/brand_primary"/>
            </RadioGroup>

            <Button android:id="@+id/btnHoldToTalk"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="2dp"
                android:backgroundTint="#E0E0E0"
                android:textColor="@android:color/black"
                android:textSize="14sp" android:textStyle="bold"
                android:text="按住 开始讲话"/>

            <LinearLayout android:id="@+id/fullDuplexBar"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:visibility="gone"
                android:paddingVertical="2dp">
                <Button android:id="@+id/btnCallAnswer"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:backgroundTint="#17A060"
                    android:textColor="@color/white" android:textSize="13sp"
                    android:text="接听"/>
                <Button android:id="@+id/btnCallHangup"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    android:backgroundTint="@color/alarm_red"
                    android:textColor="@color/white" android:textSize="13sp"
                    android:text="挂断"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>