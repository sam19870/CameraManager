<?xml version="1.0" encoding="utf-8"?>
<!-- 完全对标 TP-Link Tapo 官方 App 预览页 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 全屏视频 -->
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部栏：Tapo风格 -->
        <LinearLayout android:id="@+id/topBar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="#99000000"
            android:paddingHorizontal="4dp" android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageView android:id="@+id/btnBack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back_white"
                android:contentDescription="返回"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:paddingStart="2dp"
                android:orientation="vertical">
                <TextView android:id="@+id/deviceName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/white" android:textStyle="bold"
                    android:textSize="14sp"/>
                <TextView android:id="@+id/routeText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF" android:textSize="10sp"
                    android:visibility="gone"/>
            </LinearLayout>

            <TextView android:id="@+id/statusText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#80FFFFFF" android:textSize="10sp"
                android:layout_marginEnd="4dp"/>

            <ImageView android:id="@+id/btnMore"
                android:layout_width="40dp" android:layout_height="40dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_gear"
                android:contentDescription="设置"/>
        </LinearLayout>

        <!-- 中间填充 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/recordIndicator"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_red_pill"
                android:paddingHorizontal="8dp" android:paddingVertical="2dp"
                android:textColor="@color/white" android:textSize="10sp"
                android:text="● REC"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- 重连蒙层 -->
        <LinearLayout android:id="@+id/reconnectOverlay"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="#CC000000"
            android:paddingHorizontal="12dp" android:paddingVertical="8dp"
            android:visibility="gone">
            <ProgressBar android:id="@+id/reconnectProgress"
                android:layout_width="20dp" android:layout_height="20dp"
                android:indeterminateTint="@color/white"
                android:visibility="gone"/>
            <TextView android:id="@+id/reconnectHint"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="#FFCDD2" android:textSize="12sp"/>
            <Button android:id="@+id/btnReconnect"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginStart="8dp"
                style="?attr/materialButtonOutlinedStyle"
                android:textColor="@color/white"
                app:strokeColor="@color/white"
                android:textSize="12sp" android:text="重连"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ====== Tapo 底部控件（完全对标官方） ====== -->

        <!-- 第一行：截图 | 录像 | 画质 | 日夜 | 全屏 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#CC000000"
            android:paddingHorizontal="6dp"
            android:paddingTop="8dp" android:paddingBottom="2dp">

            <LinearLayout android:id="@+id/btnSnapshot"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_snapshot"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="截图" android:textColor="@color/white"
                    android:textSize="10sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnRecord"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:id="@+id/recordIcon" android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_record"/>
                <TextView android:id="@+id/recordLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="录像" android:textColor="@color/white"
                    android:textSize="10sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnProfile"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_resolution"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="画质" android:textColor="@color/white"
                    android:textSize="10sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnNightMode"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_night"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="日夜" android:textColor="@color/white"
                    android:textSize="10sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnFullScreen"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_fullscreen"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="全屏" android:textColor="@color/white"
                    android:textSize="10sp" android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 第二行：音量 | 语音通话 | 对讲 | 云台 | 告警 | 回放 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#CC000000"
            android:paddingHorizontal="6dp"
            android:paddingTop="4dp" android:paddingBottom="10dp">

            <LinearLayout android:id="@+id/btnMute"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:id="@+id/muteIcon" android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_volume"/>
                <TextView android:id="@+id/muteLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="有声" android:textColor="@color/white"
                    android:textSize="10sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnVoiceCall"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_phone"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="语音通话" android:textColor="@color/white"
                    android:textSize="10sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnAudio"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_mic"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="对讲" android:textColor="@color/white"
                    android:textSize="10sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnPtz"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_ptz_control"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="云台" android:textColor="@color/white"
                    android:textSize="10sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnAlarm"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:id="@+id/alarmIcon" android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_alarm"/>
                <TextView android:id="@+id/alarmLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="告警开" android:textColor="@color/white"
                    android:textSize="10sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnPlayback"
                style="@style/ToolBtn" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_playback"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="回放" android:textColor="@color/white"
                    android:textSize="10sp" android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 隐私模式按钮（独立一行） -->
        <LinearLayout
            android:id="@+id/btnPrivacy"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#CC000000"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp" android:paddingBottom="12dp"
            android:visibility="gone">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_tool_rounded"
                android:paddingHorizontal="20dp" android:paddingVertical="8dp"
                android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView android:id="@+id/privacyIcon" android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_video_block"/>
                <TextView android:id="@+id/privacyLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  隐私模式" android:textColor="@color/white"
                    android:textSize="13sp" android:layout_marginStart="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ====== 云台控制盘（Tapo风格：方向键圆盘） ====== -->
        <LinearLayout android:id="@+id/ptzPanel"
            android:layout_width="match_parent" android:layout_height="240dp"
            android:gravity="center"
            android:background="#DD000000"
            android:visibility="gone"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="220dp" android:layout_height="220dp">

                <View android:layout_width="200dp" android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ptz_disc"/>

                <ImageView android:id="@+id/ptzUp"
                    android:layout_width="56dp" android:layout_height="56dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="14dp" android:src="@drawable/ic_ptz_up"
                    android:contentDescription="上"/>

                <ImageView android:id="@+id/ptzDown"
                    android:layout_width="56dp" android:layout_height="56dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="14dp" android:src="@drawable/ic_ptz_down"
                    android:contentDescription="下"/>

                <ImageView android:id="@+id/ptzLeft"
                    android:layout_width="56dp" android:layout_height="56dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="14dp" android:src="@drawable/ic_ptz_left"
                    android:contentDescription="左"/>

                <ImageView android:id="@+id/ptzRight"
                    android:layout_width="56dp" android:layout_height="56dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="14dp" android:src="@drawable/ic_ptz_right"
                    android:contentDescription="右"/>

                <LinearLayout
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:orientation="horizontal"
                    android:gravity="center">
                    <ImageView android:id="@+id/ptzZoomOut"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp" android:src="@drawable/ic_zoom_out"
                        android:contentDescription="缩小"/>
                    <View android:layout_width="12dp" android:layout_height="1dp"/>
                    <ImageView android:id="@+id/ptzZoomIn"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp" android:src="@drawable/ic_zoom_in"
                        android:contentDescription="放大"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ====== 内联对讲面板 ====== -->
        <LinearLayout android:id="@+id/audioPanel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#DD000000"
            android:paddingHorizontal="12dp" android:paddingVertical="8dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#80FFFFFF" android:textSize="11sp"
                    android:text="按住说话模式"/>
                <ImageView android:id="@+id/audioClose"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"/>
            </LinearLayout>

            <RadioGroup android:id="@+id/audioModeGroup"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">
                <RadioButton android:id="@+id/radioHoldTalk"
                    android:layout_width="0dp" android:layout_height="36dp"
                    android:layout_weight="1" android:textSize="12sp"
                    android:textColor="@color/white" android:text="按住说话"
                    android:buttonTint="@color/brand_primary"/>
                <RadioButton android:id="@+id/radioFullDuplex"
                    android:layout_width="0dp" android:layout_height="36dp"
                    android:layout_weight="1" android:textSize="12sp"
                    android:textColor="@color/white" android:text="电话对讲"
                    android:buttonTint="@color/brand_primary"/>
            </RadioGroup>

            <Button android:id="@+id/btnHoldToTalk"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="2dp"
                android:backgroundTint="#E0E0E0"
                android:textColor="@android:color/black"
                android:textSize="14sp" android:textStyle="bold"
                android:text="按住 开始讲话"/>

            <LinearLayout android:id="@+id/fullDuplexBar"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:visibility="gone"
                android:paddingVertical="2dp">
                <Button android:id="@+id/btnCallAnswer"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:backgroundTint="#17A060"
                    android:textColor="@color/white" android:textSize="13sp"
                    android:text="接听"/>
                <Button android:id="@+id/btnCallHangup"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    android:backgroundTint="@color/alarm_red"
                    android:textColor="@color/white" android:textSize="13sp"
                    android:text="挂断"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>