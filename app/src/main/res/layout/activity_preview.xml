<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent" android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:orientation="vertical"
        android:background="@drawable/bg_top_gradient">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="56dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:layout_marginTop="24dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp" android:src="@drawable/ic_back_white"
                android:contentDescription="返回"/>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="4dp">
                <TextView android:id="@+id/titleText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/white" android:textSize="16sp"
                    android:textStyle="bold" android:maxLines="1"
                    android:ellipsize="end" android:text="摄像头"/>
                <LinearLayout
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="2dp">
                    <View android:layout_width="6dp" android:layout_height="6dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/dot_online"/>
                    <TextView android:id="@+id/statusText"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#CCFFFFFF" android:textSize="11sp"
                        android:text="连接中"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#80FFFFFF" android:textSize="11sp"
                        android:text=" · " android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"/>
                    <TextView android:id="@+id/routeText"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#B8E0FF" android:textSize="11sp"
                        android:text="选路中…"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/profileText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="12sp"
                android:background="#4D000000" android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" android:layout_marginEnd="8dp"
                android:text="标清"/>

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp" android:src="@drawable/ic_more_vert_white"
                android:contentDescription="更多设置"/>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/timeoutText"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="96dp"
        android:layout_marginEnd="12dp" android:background="#80CC3300"
        android:paddingHorizontal="8dp" android:paddingVertical="4dp"
        android:textColor="@color/white" android:textSize="11sp"
        android:text="超时: 0" android:visibility="gone"/>

    <View android:id="@+id/recordIndicator"
        android:layout_width="10dp" android:layout_height="10dp"
        android:layout_gravity="top|end" android:layout_marginTop="100dp"
        android:layout_marginEnd="96dp"
        android:background="@drawable/dot_online" android:visibility="gone"/>

    <LinearLayout android:id="@+id/reconnectOverlay"
        android:layout_width="260dp" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical"
        android:gravity="center" android:visibility="gone"
        android:background="@drawable/bg_reconnect_card" android:padding="20dp">
        <ProgressBar
            android:id="@+id/reconnectProgress"
            android:layout_width="36dp" android:layout_height="36dp"
            android:indeterminateTint="@color/brand_accent"/>
        <TextView android:id="@+id/reconnectHint"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/white" android:textSize="13sp"
            android:gravity="center"
            android:text="画面无响应，正在重连"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReconnect"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cornerRadius="20dp"
            android:backgroundTint="@color/brand_accent"
            android:textColor="@color/black"
            android:text="手动重连"
            android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:background="@drawable/bg_bottom_gradient">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:paddingTop="16dp" android:paddingBottom="4dp"
            android:paddingHorizontal="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSnapshot" style="@style/IconActionBtn"
                app:icon="@drawable/ic_snapshot" android:text="截图"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecord" style="@style/IconActionBtn"
                app:icon="@drawable/ic_record" android:text="录像"
                app:iconTint="@color/alarm_red"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAudio" style="@style/IconActionBtn"
                app:icon="@drawable/ic_mic" android:text="对讲"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfile" style="@style/IconActionBtn"
                app:icon="@drawable/ic_resolution" android:text="清晰度"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoreTools" style="@style/IconActionBtn"
                app:icon="@drawable/ic_toolbox" android:text="更多"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/ptzPanel"
            android:layout_width="match_parent" android:layout_height="260dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="220dp" android:layout_height="220dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ptz_disc"/>

            <ImageView android:id="@+id/ptzUp"
                android:layout_width="56dp" android:layout_height="56dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp" android:src="@drawable/ic_ptz_up"
                app:tint="@color/white"/>
            <ImageView android:id="@+id/ptzDown"
                android:layout_width="56dp" android:layout_height="56dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp" android:src="@drawable/ic_ptz_down"
                app:tint="@color/white"/>
            <ImageView android:id="@+id/ptzLeft"
                android:layout_width="56dp" android:layout_height="56dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp" android:src="@drawable/ic_ptz_left"
                app:tint="@color/white"/>
            <ImageView android:id="@+id/ptzRight"
                android:layout_width="56dp" android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp" android:src="@drawable/ic_ptz_right"
                app:tint="@color/white"/>
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:orientation="horizontal"
                android:gravity="center">
                <ImageView android:id="@+id/ptzZoomOut"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp" android:src="@drawable/ic_zoom_out"
                    app:tint="@color/white"/>
                <View android:layout_width="64dp" android:layout_height="64dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_ptz_center"/>
                <ImageView android:id="@+id/ptzZoomIn"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp" android:src="@drawable/ic_zoom_in"
                    app:tint="@color/white"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:orientation="horizontal" android:padding="12dp">
                <com.google.android.material.chip.Chip
                    android:id="@+id/btnPreset"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="预置位" android:textSize="12sp"
                    app:chipBackgroundColor="#40000000"
                    android:textColor="@color/white"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/btnCruise"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="巡航" android:textSize="12sp"
                    app:chipBackgroundColor="#40000000"
                    android:textColor="@color/white"/>
            </LinearLayout>
        </FrameLayout>

        <View android:layout_height="8dp" android:layout_width="match_parent"/>
    </LinearLayout>
</FrameLayout>
