<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp" android:padding="14dp"
    android:background="@drawable/bg_card_rounded">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tunnelName"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/text_primary"
            android:textSize="16sp" android:textStyle="bold" android:text="通道名称"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/tunnelSwitch"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:id="@+id/tunnelHost"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/text_secondary"
        android:textSize="13sp" android:text="host:port"/>

    <TextView android:id="@+id/tunnelOnvif"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="@color/text_secondary"
        android:textSize="13sp" android:text="ONVIF 端口: 0"/>

    <TextView android:id="@+id/tunnelRemark"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="@color/text_secondary"
        android:textSize="12sp" android:visibility="gone"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp"
        android:gravity="end">
        <Button android:id="@+id/btnEdit" style="@style/ActionButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minWidth="0dp" android:paddingHorizontal="16dp" android:text="编辑"/>
        <Button android:id="@+id/btnDelete" style="@style/ActionButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:minWidth="0dp"
            android:paddingHorizontal="16dp" android:backgroundTint="@color/brand_accent"
            android:textColor="@color/black" android:text="删除"/>
    </LinearLayout>
</LinearLayout>
