<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="6dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical"
        android:background="@color/bg_card" android:layout_margin="2dp">
        <SurfaceView android:id="@+id/tileSurface"
            android:layout_width="match_parent" android:layout_height="160dp"
            android:background="#000000"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="8dp" android:gravity="center_vertical">
            <TextView android:id="@+id/tileName"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="@color/text_primary"
                android:textSize="14sp" android:text="摄像头"/>
            <TextView android:id="@+id/tileStatus"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="12sp"
                android:text="● 在线"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
